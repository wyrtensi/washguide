# Lives in /opt/edge/sites/ on the server. TLS for washguide.ru ends here; the
# pages come from the washguide-web container (deploy/server/docker-compose.yml).
www.washguide.ru {
	redir https://washguide.ru{uri} permanent
}

washguide.ru {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# The visit counter (shared GoatCounter, see rusinternet deploy/server/stats)
	# is reached through the site itself. Only the script and the count endpoint
	# pass; the dashboard stays on stats.wyrtensi.ru.
	@counter path /stats/count /stats/count.js
	handle @counter {
		uri strip_prefix /stats
		reverse_proxy goatcounter:8080 {
			header_up Host stats.wyrtensi.ru
		}
	}

	handle {
		reverse_proxy washguide-web:80
	}

	log {
		output stdout
		format console
	}
}
