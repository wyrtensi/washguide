# Lives in /opt/edge/sites/ on the server. TLS for washguide.ru ends here; the
# pages come from the washguide-web container (deploy/server/docker-compose.yml).
www.washguide.ru {
	redir https://washguide.ru{uri} permanent
}

washguide.ru {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy washguide-web:80

	log {
		output stdout
		format console
	}
}
