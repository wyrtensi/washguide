      "softener-only": {
        "title": "One rinse with softener",
        "note": "Quickly freshen clean items.",
        "dose": {
          "4": "Softener"
        }
      },
      "spin-only": {
        "title": "Spin only",
        "note": "Drain the water and spin. Put in several items so that the drum balances."
      },
      "drain-only": {
        "title": "Drain only",
        "note": "If the machine has stopped with water and you need to take the items out without spinning."
      }
    },
    "troubleshooting": [
      {
        "title": "The machine stopped with water in the drum",
        "causes": [
          "The wash was on programmes 8-11 or 14-16: this is by design. Switch off I/O, turn P to 12 or 13 (synthetics), 17 or 18 (wool) and switch on.",
          "The stop-with-water button is pressed - release it.",
          "The pump filter is blocked - clean it."
        ]
      },
      {
        "title": "It takes in water and drains it at once",
        "causes": [
          "The drain hose hangs too low: the top point of the hose must be 60-70 cm above the floor.",
          "The end of the hose is submerged in water - an air gap is needed."
        ]
      },
      {
        "title": "Vibrates strongly on the spin",
        "causes": [
          "There is one heavy item in the drum - add a few more.",
          "The machine is not level or the lock nuts on the feet have loosened."
        ]
      },
      {
        "title": "The door does not open after the wash",
        "causes": [
          "The lock is cooling down: switch off I/O and wait 2-3 minutes until it clicks."
        ]
      },
      {
        "title": "Does not switch on or does not take in water",
        "causes": [
          "The door is not closed until it clicks.",
          "Knob P is on a stop dot.",
          "The tap is closed or the screen at the inlet of the fill hose is blocked."
        ]
      },
      {
        "title": "A lot of foam or powder stays in the drawer",
        "causes": [
          "The powder is not for automatic machines.",
          "The drawer insert is blocked - remove it and rinse."
        ]
      }
    ],
    "care": [
      {
        "title": "Drain pump filter",
        "text": "Disconnect the machine from the mains, remove the lower panel, place a container underneath, unscrew the filter plug anticlockwise, rinse and screw it back fully.",
        "interval": "every 3-4 months"
      },
      {
        "title": "Detergent drawer",
        "text": "Pull the drawer out towards you, remove the right-hand insert, rinse with warm water.",
        "interval": "every 1-2 months"
      },
      {
        "title": "Fill hose screen",
        "text": "If the water fills slowly, unscrew the hose nut and rinse the screen under the gasket.",
        "interval": "as needed"
      },
      {
        "title": "After every wash",
        "text": "Leave the door slightly open, wipe the seal, close the water tap.",
        "interval": "every time"
      }
    ],
    "notes": {
      "assumptions": [
        "The angles of the marks on the knobs are taken from a photo of the panel, approximately.",
        "The durations of the programmer steps are an estimate from a typical Merloni cycle chart; the manual does not give them.",
        "The water volume of the main wash (12 l) is an estimate for a 3.5 kg tub.",
        "The speed of the MIN position (300) and the spin limits for synthetics (600) and wool (400) have not been checked against the manual."
      ],
      "gaps": [
        "The manual does not give programme durations.",
        "There is no link to an electronic version of the manual."
      ]
    },
    "sources": [
      "Operating manual Indesit WGS 834 TXR (RU), owner's paper copy",
      "Photos of the panel and drawer of this particular machine"
    ]
  }
