        "name": "Softening (fabric softener) and spin"
      },
      "7": {
        "name": "Spin"
      },
      "8": {
        "name": "Synthetics and mixed fabrics, 60 °C"
      },
      "9": {
        "name": "Synthetics, delicate wash, 40 °C"
      },
      "10": {
        "name": "Synthetics rinse"
      },
      "11": {
        "name": "Synthetics softening"
      },
      "12": {
        "name": "Delicate spin for synthetics"
      },
      "13": {
        "name": "Drain"
      },
      "14": {
        "name": "Wool, hand wash, tulle"
      },
      "15": {
        "name": "Wool rinse"
      },
      "16": {
        "name": "Wool softening"
      },
      "17": {
        "name": "Delicate spin for wool"
      },
      "18": {
        "name": "Drain without turning the drum"
      }
    },
    "rules": [],
    "presets": {
      "everyday-40": {
        "title": "Everyday clothes",
        "note": "Short path: wash at step 4, rinses 5-6, spin 7. Suitable for items worn once.",
        "dose": {
          "2": "Powder or gel",
          "4": "Softener if desired"
        }
      },
      "dirty-40": {
        "title": "Heavily soiled, 40 °C",
        "note": "Long path 2 → 3 → 4: the wash takes almost an hour. For well-worn clothes.",
        "dose": {
          "2": "Powder",
          "4": "Softener if desired"
        }
      },
      "small-30": {
        "title": "Few items, 30 °C",
        "note": "The 1/2 button reduces the water. Up to 1.5 kg.",
        "dose": {
