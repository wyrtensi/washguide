        }
      },
      "bedding-60": {
        "title": "Bedding and towels",
        "note": "Cotton at 60 °C - a hygienic wash without boiling.",
        "dose": {
          "2": "Powder",
          "4": "Softener"
        }
      },
      "synthetics-40": {
        "title": "Synthetics, jackets, shirts",
        "note": "Gentle tumbling in a large volume of water. At the end the machine will stop with water at 11.",
        "dose": {
