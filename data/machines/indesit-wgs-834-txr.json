  "en": {
    "summary": "A narrow front-loading machine with a mechanical programmer: three oval buttons on the left and three knobs on the right, programmes 1-18 without names, only numbers.",
    "years": "late 1990s - early 2000s",
    "pitfalls": [
      "The programme knob P is turned only clockwise and only when the I/O button is off.",
      "On programmes 8-11 and 14-16 the machine stops at the end with water in the tub - this is not a fault.",
      "The starting number sets the step from which the cycle begins: \"2\" and \"4\" on cotton differ by about 45 minutes.",
      "The door opens only 2-3 minutes after switching off."
    ],
    "controls": {
      "power": {
        "help": "Power button. The programme starts immediately after pressing, so set the knobs first."
      },
      "lamp-on": {
        "help": "Lit while the machine is on."
      },
      "half": {
        "help": "Half load: the machine takes less water for washing and rinsing. For 1.5 kg and less."
      },
      "waterstop": {
        "help": "Stop with water: the machine does not drain the water after the last rinse. To continue, release the button."
      },
      "spin": {
        "help": "Final spin speed. At \"no spin\" the machine only drains the water.",
        "label": "rpm",
        "positions": {
          "0": "no spin"
        }
      },
      "temp": {
        "help": "Thermostat: the temperature to which the heater warms the water. The timer stands still while the water is heating."
      },
      "prog": {
        "help": "Programme selection. The number is the programmer step from which the cycle will begin. Turn clockwise only, with the machine off.",
        "zones": {
          "cotton": "Cotton 1-7",
          "synthetic": "Synthetics 8-13",
          "wool": "Wool 14-18"
        }
      }
    },
    "tray": {
      "help": "The drawer pulls out towards you with a little effort. The right-hand insert with compartments 3 and 4 lifts out upwards: thickened softener builds up under it, so it is worth rinsing.",
      "compartments": {
        "1": "Prewash",
        "2": "Main wash",
        "3": "Bleach",
        "4": "Fabric softener"
      }
    },
    "programs": {
      "1": {
        "name": "Cotton, very dirty, with prewash"
      },
      "2": {
        "name": "Cotton, intensive wash"
      },
      "3": {
        "name": "Cotton, normal soiling"
      },
      "4": {
        "name": "Cotton, lightly soiled, short wash"
      },
      "5": {
        "name": "Rinses and spin"
      },
